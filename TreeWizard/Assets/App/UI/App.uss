:root {
  --panel-bg: rgba(30, 32, 35, 0.94);
  --window-bg: rgb(42, 45, 49);
  --text: rgb(227, 229, 232);
  --text-dim: rgb(154, 160, 166);
  --accent: rgb(67, 160, 71);
  --accent-hover: rgb(88, 182, 92);
  --divider: rgba(255, 255, 255, 0.08);
}

.app {
  flex-grow: 1;
}

.sidebar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 380px;
  padding: 12px;
  background-color: var(--panel-bg);
  border-right-width: 1px;
  border-right-color: var(--divider);
}

.sidebar__title {
  font-size: 20px;
  -unity-font-style: bold;
  margin-bottom: 8px;
}

.toolbar {
  flex-direction: row;
  margin-bottom: 8px;
}

.toolbar__button {
  flex-grow: 1;
  margin-left: 0;
  margin-right: 4px;
}

.toolbar__button--primary {
  margin-right: 0;
  background-color: var(--accent);
  color: rgb(255, 255, 255);
}

.toolbar__button--primary:hover {
  background-color: var(--accent-hover);
}

.sidebar__scroll {
  flex-grow: 1;
  margin-top: 8px;
}

.sidebar__wind {
  margin-top: 8px;
}

.sidebar__stats {
  margin-top: 8px;
  color: var(--text-dim);
  -unity-font-style: italic;
}

.sidebar .unity-label,
.sidebar .unity-foldout__text {
  color: var(--text);
}

.sidebar .unity-base-field__label {
  min-width: 130px;
}

.sidebar .unity-foldout__checkmark {
  -unity-background-image-tint-color: var(--text);
}

.tw-settings__section {
  margin-top: 4px;
}

.tw-settings__section > .unity-foldout__toggle .unity-foldout__text {
  -unity-font-style: bold;
}

.tw-settings__row {
  flex-direction: row;
  align-items: center;
}

.tw-settings--grow {
  flex-grow: 1;
}

.textures__row {
  flex-direction: row;
  align-items: center;
  min-height: 24px;
}

.textures__label {
  min-width: 96px;
}

.sidebar .textures__value {
  flex-grow: 1;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-dim);
}

.textures__button {
  margin-right: 0;
}

.textures__reset {
  align-self: flex-end;
  margin: 4px 0 0;
}

.status {
  display: none;
  position: absolute;
  left: 396px;
  bottom: 16px;
  padding: 6px 10px;
  border-radius: 4px;
  background-color: rgba(0, 0, 0, 0.6);
  color: rgb(255, 255, 255);
}

.status--visible {
  display: flex;
}
